# ─── Server .env.production ─────────────────────────────────────────────────
# Copy to server/.env on the production server and fill in __REPLACE__ values

# ── Node ──
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL) ──
# Option A: individual fields
DB_HOST=192.168.10.125
DB_PORT=5432
DB_NAME=medway_cms_db
DB_USER=postgres
DB_PASSWORD=Medway@123
# Option B: full connection string (overrides above if set)
# DATABASE_URL=postgresql://user:pass@192.168.10.125:5432/medway_cms_db?sslmode=require
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000

# ── Auth ──
JWT_SECRET=__REPLACE_WITH_STRONG_JWT_SECRET__
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://192.168.10.125:5000

# ── CORS (comma-separated origins that the browser may connect from) ──
CORS_ORIGIN=http://192.168.10.125:5000,http://localhost:5000

# ── VAC Dialer ──
VAC_SERVER_URL=http://192.168.10.126
VAC_API_TOKEN=A7F9K2XQ4M8Z1B6C
VAC_TIMEOUT_MS=10000
VAC_WEBHOOK_SECRET=53796b5d6b698e3dc8783e85d317f91914434baa0c8e0b3226404e7c84dd6bd9
VAC_ALLOWED_IPS=192.168.10.126

# ── Telephony vendor webhook (HMAC) ──
TELEPHONY_WEBHOOK_SECRET=

# ── Email / SMTP (for password-reset emails) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medilead.app

# $ node server/scripts/generateLicenseEnv.js --expiry 2026-06-30 --unlock-key mySecretKey 
# ─── License Enforcement ─── 
LICENSE_EXPIRY="2026-07-31"
LICENSE_HMAC_SECRET="75568c3e8eb3da155859a615a0be9498db86c299c3040c8c0c5b56940fea648a"LICENSE_EXPIRY_HMAC="d5e8a79a2b4d996da0b2634da4185d669b5307708f245b5ee34aa153efdedf1e"
LICENSE_GRACE_DAYS=3
LICENSE_UNLOCK_HASH="$2a$12$aNg192.U5Zq47EqVCYIOXuRl2ElREQqxYgVLsahC2abV04BBUXQui"
UNLOCK_ALLOWED_IPS="127.0.0.1"

# ── Logging ──
LOG_LEVEL=info
