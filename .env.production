# ─── Frontend .env.production ───────────────────────────────────────────────
# Build with:  npx vite build
# This file is baked into the JS bundle at build time.

# API — served by the same origin in production (no cross-origin needed)
VITE_API_URL=http://192.168.10.125:5000/api

# App
VITE_APP_NAME=MediLead CMS
VITE_APP_ENV=production

# Socket.IO — connects to the same origin (NO /api suffix)
VITE_SOCKET_URL=http://192.168.10.125:5000

# SIP (optional — leave defaults if SIP is not used)
VITE_SIP_WS_URL=ws://localhost:8088/ws
VITE_SIP_DOMAIN=medilead.local

# VAC Dialer — direct frontend-to-VAC for click2call
VITE_VAC_SERVER_URL=http://192.168.10.126
VITE_VAC_API_TOKEN=A7F9K2XQ4M8Z1B6C
